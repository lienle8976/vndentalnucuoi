# Biến môi trường đặt trên host khi deploy backend (Render, Railway, Fly.io...).
# KHÔNG commit giá trị thật. Trên host không có file ../.env — mọi cấu hình lấy từ đây.

NODE_ENV=production

# Chuỗi kết nối ClinicCyberDB trên Neon = CLINIC_PROD_DATABASE_URL trong .env ở máy
DATABASE_URL=postgresql://LienAdmin:<mat_khau>@ep-xxxx.ap-southeast-1.aws.neon.tech/ClinicCyberDB?sslmode=verify-full

# Khóa ký JWT, ít nhất 32 ký tự, KHÁC khóa ở máy local
CLINIC_JWT_SECRET=<chuoi_ngau_nhien_64_ky_tu>

# Tùy chọn
# PORT=4000            # host thường tự cấp, không cần đặt
# HOST=0.0.0.0         # mặc định ở production
# DB_POOL_MAX=5        # số kết nối tối đa tới DB (gói free nên để nhỏ)
# COOKIE_SECURE=true   # mặc định true ở production; false nếu thử production qua http

# Build / Start trên host (Root Directory = backend):
#   Build:  npm ci --omit=dev
#   Start:  npm start
#   Health check: /api/health
