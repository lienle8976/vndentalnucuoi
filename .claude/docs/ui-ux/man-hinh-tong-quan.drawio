ẩu&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:10px&quot;&gt;/doi-mat-khau&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UC02 · Tất cả&lt;/font&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="90" width="230" height="74" as="geometry"/></mxCell><mxCell id="1Smnhn6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=10;" edge="1" parent="1" source="1Smnhn3" target="1Smnhn4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1Smnhn7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748b;fontSize=10;" edge="1" parent="1" source="1Smnhn4" target="1Smnhn5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1Smnhn8" value="&lt;b&gt;Tiếp đón&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#0f766e;fontColor=#ffffff;strokeColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="320" height="36" as="geometry"/></mxCell><mxCell id="1Smnhn9" value="&lt;b&gt;Khám &amp; điều trị&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#0f766e;fontColor=#ffffff;strokeColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="220" width="320" height="36" as="geometry"/></mxCell><mxCell id="1Smnhn10" value="&lt;b&gt;Thu ngân&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#0f766e;fontColor=#ffffff;strokeColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="220" width="320" height="36" as="geometry"/></mxCell><mxCell id="1Smnhn11" value="&lt;b&gt;Danh mục &amp; kho&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#0f766e;fontColor=#ffffff;strokeColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1180" y="220" width="320" height="36" as="geometry"/></mxCell><mxCell id="1Smnhn12" value="&lt;b&gt;Quản lý&